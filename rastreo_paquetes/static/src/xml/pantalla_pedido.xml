<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="rastreo_paquetes.pantalla_pedido">
        <div class="odoo-screen">

            <!-- ============================================
                 ENCABEZADO
                 ============================================ -->
            <div class="odoo-screen-header">
                <h2>
                    <i class="fa fa-cube me-2"/>
                    Cotización: <t t-esc="state.guia or 'Sin número'"/>
                </h2>

                <div class="ms-auto d-flex gap-2">
                    <button type="button"
                            class="odoo-btn odoo-btn-ghost"
                            t-on-click="onClickCambiarEstado">
                        <i class="fa fa-exchange"/> Cambiar estado
                    </button>
                    <button type="button"
                            class="odoo-btn odoo-btn-primary"
                            t-on-click="onGuardarDetalleGeneral">
                        <i class="fa fa-save"/> Guardar
                    </button>
                    <button type="button"
                            class="odoo-btn odoo-btn-secondary"
                            t-on-click="onClickRegresar">
                        <i class="fa fa-home"/> Pantalla Principal
                    </button>
                </div>
            </div>

            <div class="odoo-screen-grid">

                <div class="odoo-col-left">

                   
                    <div class="odoo-card odoo-card-accent">
                        <div class="odoo-card-title">
                            <i class="fa fa-info-circle"/> Detalle general de el pedido:
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="odoo-field">
                                    <label class="odoo-label" for="numero_guia">Número de Cotización:</label>
                                    <input type="text"
                                            id="numero_guia"
                                            class="odoo-input"
                                            placeholder="Ej. GUIA-001"
                                            t-model="state.guia"/>
                                </div>
                            </div>

                            <button  class="odoo-btn odoo-btn-ghost" t-on-click="() => this.onCambiarCotizacion()">
                                 <i class="fa fa-exchange"/>  Buscar Cotización
                            </button>
                            <div class="col-md-6">
                                <div class="odoo-field">
                                    <label class="odoo-label" for="numero_contrato">Número de Contrato</label>
                                    <input type="text"
                                           id="numero_contrato"
                                           class="odoo-input"
                                           t-att-value="state.numeroContrato or ''"
                                           />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="odoo-field">
                                    <label class="odoo-label">Cliente</label>
                                    <input type="text"
                                           class="odoo-input"
                                           t-att-value="state.clienteNombre or ''"
                                           readonly="readonly"/>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="odoo-field">
                                    <label class="odoo-label" for="forwarder">Forwarder</label>
                                    <input type="checkbox"
                                        id="forwarder"
                                        class="odoo-input"
                                        t-att-checked="state.forwarder"
                                        t-on-change="(ev) => this.onVerificarForwarder(ev)"/>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="odoo-field">
                                    <label class="odoo-label" for="total_cliente">Total Cliente</label>
                                    <input type="text"
                                           id="total_cliente"
                                           class="odoo-input"
                                           t-att-value="state.totalCliente || 0"
                                           readonly="readonly"
                                           />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="odoo-field">
                                    <label class="odoo-label" for="total_cliente">Total Anticipos de cliente:</label>
                                    <input type="text"
                                           id="total_cliente"
                                           class="odoo-input"
                                           t-att-value="state.totalAnticiposCliente || 0"
                                           readonly="readonly"
                                           />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="odoo-field">
                                    <label class="odoo-label" for="total_cliente">Total Anticipos al Proveedor:</label>
                                    <input type="text"
                                           id="total_cliente"
                                           class="odoo-input"
                                           t-att-value="state.totalAnticiposProveedor || 0"
                                           readonly="readonly"
                                           />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="odoo-field">
                                    <label class="odoo-label" for="total_proveedor">Total Proveedor</label>
                                    <input type="number"
                                           id="total_proveedor"
                                           class="odoo-input"
                                           step="0.1"
                                           t-att-value="state.totalProveedor || 0"
                                          />
                                </div>
                            </div>

                        </div>
                    </div>



                    <!-- CLIENTE  -->
                    <div class="odoo-card">
                        <div class="odoo-card-title">
                            <i class="fa fa-user"/> Cliente
                        </div>

                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th>Número</th>
                                        <th>Fecha de Anticipo</th>
                                        <th class="text-end">Cantidad</th>
                                        <th class="text-end">Precio dólar</th>
                                        <th class="text-center">PDF anticipo</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="state.detalleCliente and state.detalleCliente.length">
                                        <tr t-foreach="state.detalleCliente" t-as="d" t-key="d.id">
                                            <td><t t-esc="d.numero or ''"/></td>
                                            <td><t t-esc="d.fechaAnticipo or ''"/></td>
                                            <td class="text-end"><t t-esc="d.cantidadAnticipo or 0"/></td>
                                            <td class="text-end"><t t-esc="d.precioDolar or 0"/></td>
                                             <td class="text-end"><t t-esc="d.PDFAnticipo or 'No cargado'"/></td>
                                            <td class="text-center">
                                                <button class="odoo-btn odoo-btn-sm odoo-btn-cyan"
                                                        t-on-click="() => this.onEditarDetalleCliente(d)">
                                                    Editar
                                                </button>
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-else="">
                                        <tr>
                                            <td colspan="5" class="text-center text-muted">
                                                Sin registros
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>

                        <div class="text-center">
                            <button class="odoo-btn odoo-btn-block odoo-btn-ghost"
                                    t-on-click="() => this.onEditarDetalleCliente()">
                                <i class="fa fa-plus"/> Agregar Nuevo Anticipo
                            </button>
                        </div>
                    </div>

                    

                </div>

                <div class="odoo-col-right">

                    <!-- ESTADO DEL PEDIDO  -->
                    <div class="odoo-card">
                        <div class="odoo-card-title">
                            <i class="fa fa-flag"/> Estado del pedido
                        </div>
                        <div class="odoo-result-row">
                            <span class="odoo-result-label">Estado actual</span>
                            <span class="odoo-result-value">
                                <t t-esc="state.estado or 'Sin estado'"/>
                            </span>
                        </div>
                    </div>

                    <!--  DOCUMENTOS DEL SISTEMA  -->
                    <div class="odoo-card">
                        <div class="odoo-card-title">
                            <i class="fa fa-folder-open"/> Documentos del sistema
                        </div>

                        <!-- Contrato Proveedor -->
                        <div class="odoo-result-row">
                            <span class="odoo-result-label">Contrato Proveedor</span>
                            <span>
                                <t t-if="state.pdfContratoProveedor">
                                    <span> <strong>En el sistema</strong> </span> 
                                <i class="oi" data-icon="check"/>
                                </t>
                                <t t-else="">
                                    <span class="text-muted">No cargado </span>
                                </t>
                                    <button type="button"
                                        class="odoo-btn odoo-btn-primary"
                                        t-on-click=" () => this.verPDF('pdf_contrato_proveedor')">
                                        <i class="fa fa-save"/> Ver
                                    </button>
                               
                            </span>
                        </div>

                        <!-- Factura Proveedor -->
                        <div class="odoo-result-row">
                            <span class="odoo-result-label">Factura Proveedor </span>
                            <span>
                                <t t-if="state.pdfFacturaProveedor">
                                    <span> <strong>En el sistema</strong> </span> 
                                <i class="oi" data-icon="check"/>
                                </t>
                                <t t-else="">
                                    <span class="text-muted">No cargado </span>
                                </t>
                                    <button type="button"
                                        class="odoo-btn odoo-btn-primary"
                                        t-on-click=" () => this.verPDF('pdf_factura_proveedor')">
                                        <i class="fa fa-save"/> Ver
                                    </button>
                                
                            </span>
                        </div>

                        <!-- ETD  -->
                        <div class="odoo-result-row">
                            <span class="odoo-result-label">ETD</span>
                            <span>
                                <t t-if="state.pdfETD">
                                    <span> <strong>En el sistema</strong> </span> 
                                <i class="oi" data-icon="check"/>
                                </t>
                                <t t-else="">
                                    <span class="text-muted">No cargado </span>
                                </t>
                                    <button type="button"
                                        class="odoo-btn odoo-btn-primary"
                                        t-on-click="  () => this.verPDF('pdf_ETD')">
                                        <i class="fa fa-save"/> Ver
                                    </button>
                                
                            </span>
                        </div>
                        <!-- ETA-->
                        <div class="odoo-result-row">
                            <span class="odoo-result-label">ETA</span>
                            <span>
                                <t t-if="state.pdfETA">
                                <span> <strong>En el sistema</strong> </span> 
                                <i class="oi" data-icon="check"/>
                                </t>
                                <t t-else="">
                                    <span class="text-muted">No cargado </span>
                                </t>
                                <button type="button"
                                    class="odoo-btn odoo-btn-primary"
                                    t-on-click=" () => this.verPDF('pdf_ETA')">
                                    <i class="fa fa-save"/> Ver
                                </button>
                                
                            </span>
                        </div>
                        <!-- ETA-->
                        <div class="odoo-result-row">
                            <span class="odoo-result-label"> BL </span>
                            <span>
                                <t t-if="state.pdfBL">
                                    <span> <strong>En el sistema</strong> </span> 
                                    <i class="oi" data-icon="check"/>
                                </t>
                                <t t-else="">
                                    <span class="text-muted">No cargado </span>
                                </t>
                                <button type="button"
                                    class="odoo-btn odoo-btn-primary"
                                    t-on-click="  () => this.verPDF('pdf_BL')">
                                    <i class="fa fa-save"/> Ver
                                </button>
                            </span>
                        </div>
                        <!-- PL-->
                        <div class="odoo-result-row">
                            <span class="odoo-result-label"> PL </span>
                            <span>
                                <t t-if="state.pdfPL">
                                    <span> <strong>En el sistema</strong> </span> 
                                    <i class="oi" data-icon="check"/>
                                </t>
                                <t t-else="">
                                    <span class="text-muted">No cargado </span>
                                </t>
                                <button type="button"
                                        class="odoo-btn odoo-btn-primary"
                                        t-on-click="  () =>this.verPDF('pdf_PL')">
                                        <i class="fa fa-save"/> Ver
                                </button>
                            </span>
                        </div>
                        <!-- invoice -->
                        <div class="odoo-result-row">
                            <span class="odoo-result-label"> invoice </span>
                            <span>
                                <t t-if="state.pdfInvoice">
                                    <span> <strong>En el sistema</strong> </span> 
                                    <i class="oi" data-icon="check"/>
                                </t>
                                <t t-else="">
                                    <span class="text-muted">No cargado </span>
                                </t>
                                <button type="button"
                                    class="odoo-btn odoo-btn-primary"
                                    t-on-click=" () => this.verPDF('pdf_invoice')">
                                    <i class="fa fa-save"/> Editar / Ver
                                </button>
                            </span>
                        </div>
                        
                    </div>

                    <!-- PROVEEDOR  -->
                    <div class="odoo-card">
                        <div class="odoo-card-title">
                            <i class="fa fa-truck"/> Proveedor
                        </div>

                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th>Número</th>
                                         <th>Fecha de Anticipo</th>
                                        <th class="text-end">Cantidad transferida</th>
                                        <th class="text-end">Precio dólar</th>
                                        <th class="text-center">PDF anticipo</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="state.detalleProveedor and state.detalleProveedor.length">
                                        <tr t-foreach="state.detalleProveedor" t-as="d" t-key="d.id">
                                            <td><t t-esc="d.numero or ''"/></td>
                                            <td><t t-esc="d.fechaAnticipo or ''"/></td>
                                            <td class="text-end"><t t-esc="d.cantidadAnticipo or 0"/></td>
                                            <td class="text-end"><t t-esc="d.precioDolar or 0"/></td>
                                             <td class="text-end"><t t-esc="d.PDFAnticipo or 'No cargado'"/></td>
                                            <td class="text-center">
                                                <button class="odoo-btn odoo-btn-sm odoo-btn-cyan"
                                                        t-on-click="() => this.onEditarDetalleProveedor(d)">
                                                    Editar 
                                                </button>
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-else="">
                                        <tr>
                                            <td colspan="5" class="text-center text-muted">
                                                Sin registros
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>

                        <div class="text-center">
                            <button class="odoo-btn odoo-btn-block odoo-btn-ghost"
                                    t-on-click="() => this.onEditarDetalleProveedor()">
                                <i class="fa fa-plus"/> Agregar Nuevo Anticipo
                            </button>
                        </div>
                    </div>

                    <div class="odoo-card">
                        <div class="odoo-card-title">
                            <i class="fa fa-cubes"/> Detalle de Racks
                        </div>

                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th>Código</th>
                                        <th>Descripción</th>
                                        <th class="text-end">Costo</th>
                                        <th class="text-end">Cant.</th>
                                        <th class="text-end">SubTotal</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="state.detalleRacks and state.detalleRacks.length">
                                        <tr t-foreach="state.detalleRacks" t-as="r" t-key="r.id">
                                            <td><t t-esc="r.clave or ''"/></td>
                                            <td><t t-esc="r.rack_nombre or ''"/></td>
                                            <td class="text-end"><t t-esc="r.costo_rack or 0"/></td>
                                            <td class="text-end"><t t-esc="r.cantidad_racks or 0"/></td>
                                            <td class="text-end"><t t-esc="r.subtotal or 0"/></td>
                                            <td class="text-end">
                                                <button class="odoo-btn odoo-btn-sm odoo-btn-ghost"
                                                        t-on-click="() => this.onEditarDetalleRacks(r)">
                                                    <i class="fa fa-pencil"/>
                                                </button>
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-else="">
                                        <tr>
                                            <td colspan="6" class="text-center text-muted">
                                                Sin racks registrados
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                        <!-- creacion de detalle para detalle rack 
                        <button class="odoo-btn odoo-btn-block odoo-btn-ghost"
                                t-on-click="() => this.onEditarDetalleRacks()">
                            <i class="fa fa-plus"/> Agregar Rack
                        </button>
                        -->
                    </div>
                </div>

            </div>

            <!-- ============================================
                 TABLA DE ACTUALIZACIONES
                 ============================================ -->
            <div class="odoo-card mt-3">
                <div class="odoo-card-title">
                    <i class="fa fa-history"/> Tabla de actualizaciones
                </div>

                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr>
                                <th>N° Actualización</th>
                                <th>Fecha</th>
                                <th>Detalle</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="state.actualizaciones and state.actualizaciones.length">
                                <tr t-foreach="state.actualizaciones" t-as="act" t-key="act.id">
                                    <td><t t-esc="act.numero_actualizacion"/></td>
                                    <td><t t-esc="act.fecha"/></td>
                                    <td><t t-esc="act.texto"/></td>
                                </tr>
                            </t>
                            <t t-else="">
                                <tr>
                                    <td colspan="3" class="text-center text-muted">
                                        No hay actualizaciones registradas.
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </t>
</templates>