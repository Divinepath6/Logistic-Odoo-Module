<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="rastreo_paquetes.componente_escoger_proveedor">
        <div class="modal d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.55);">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="fa fa-truck me-2" /> Seleccionar Proveedor
                        </h5>
                        <button type="button" class="btn-close" t-on-click="onCancelar" />
                    </div>

                    <div class="modal-body">
                        <div class="mb-3">
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fa fa-search" />
                                </span>
                                <input type="text"
                                    class="form-control"
                                    placeholder="Buscar proveedor por nombre, correo o RFC..."
                                    t-att-value="state.busqueda"
                                    t-on-input="onInputBusqueda" />
                            </div>
                        </div>

                        <div t-if="state.cargando" class="text-center py-4 text-muted">
                            <i class="fa fa-spinner fa-spin me-2" /> Buscando proveedores...
                        </div>

                        <div t-else="" class="table-responsive" style="max-height: 360px; overflow-y: auto;">
                            <table class="table table-hover table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th>Nombre</th>
                                        <th>Correo</th>
                                        <th>Teléfono</th>
                                        <th class="text-end">Acción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="state.proveedores and state.proveedores.length">
                                        <tr t-foreach="state.proveedores" t-as="prov" t-key="prov.id"
                                            t-att-class="prov.id === state.seleccionadoId ? 'table-primary' : ''"
                                            style="cursor: pointer;"
                                            t-on-click="() => this.seleccionarProveedor(prov)">
                                            <td>
                                                <strong><t t-esc="prov.name" /></strong>
                                                <span t-if="prov.supplier_rank &gt; 0"
                                                    class="badge bg-info text-dark ms-2">
                                                    Proveedor
                                                </span>
                                            </td>
                                            <td>
                                                <t t-esc="prov.email or '-'" />
                                            </td>
                                            <td>
                                                <t t-esc="prov.phone or '-'" />
                                            </td>
                                            <td class="text-end">
                                                <button type="button"
                                                    class="odoo-btn odoo-btn-sm odoo-btn-primary"
                                                    t-on-click.stop="() => this.seleccionarProveedor(prov)">
                                                    Seleccionar
                                                </button>
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-else="">
                                        <tr>
                                            <td colspan="4" class="text-center text-muted py-3">
                                                No se encontraron contactos con ese criterio.
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button"
                            class="odoo-btn odoo-btn-secondary"
                            t-on-click="onCancelar">
                            Cancelar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>