<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rastreo_paquetes.componente_subir_pdf_embed">
        <Dialog title="'Edicion de ' + (state.documentoNombre or '')" size="'md'">
            <div class="col-12 mb-3">
                <label class="form-label fw-bold">Nombre del PDF:</label>
                <input type="text"
                       class="form-control"
                       placeholder="Ej: factura_enero.pdf"
                       t-model="state.PDFNombre"/>
            </div>
            <div class="col-12">
                <PdfUploader
                    value="state.PDF"
                    filename="state.PDFNombre"
                    onChange="(b64, name) => this.onPdfChange(b64, name)"
                    previewMaxWidth="800"/>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary"
                        t-if="state.PDF"
                        t-on-click="onDescargarPDF">
                    <i class="fa fa-download me-1"/> Descargar PDF
                </button>
                <button class="btn btn-secondary" t-on-click="onConfirmar">
                    Guardar y salir
                </button>
                <button class="btn btn-secondary" t-on-click="onCancelar">
                    Cancelar
                </button>
            </t>
        </Dialog>
    </t>
</templates>