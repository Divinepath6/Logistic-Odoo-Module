<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rastreo_paquetes.componente_detalle_cliente_embed">
        <Dialog title="state.crearEditar + ' el anticipo del cliente número: ' + state.numero" size="'md'">
            
            <div class="o_form_view p-2 border rounded bg-light">
                <div class="row g-3">

                    <div class="col-md-6">
                        <label for="numero" class="form-label fw-bold">Número:</label>
                        <span id="numeroAnticipo" class="form-control" t-esc="state.numero"/>
                    </div>

                    <div class="col-md-6">
                        <label for="fecha" class="form-label fw-bold">Última fecha edición:</label>
                        <span id="fecha" class="form-control" t-esc="state.fechaEdicion"/>
                    </div>

                    <div class="col-md-6" t-if="!state.anticipoId">
                        <label for="tipo" class="form-label fw-bold">Tipo de registro:</label>
                        <select id="tipo" class="form-select" t-model="state.tipo">
                            <option value="pago">Pago</option>
                            <option value="factura">Factura</option>
                        </select>
                    </div>

                    <div class="col-md-6" t-if="state.anticipoId">
                        <label class="form-label fw-bold">Tipo:</label>
                        <span class="form-control" t-esc="state.tipo"/>
                    </div>

                    <div class="col-md-6">
                        <label for="fechaAnticipo" class="form-label fw-bold">Fecha del anticipo:</label>
                        <input type="date"
                               id="fechaAnticipo"
                               class="form-control"
                               t-model="state.fechaAnticipo"
                               t-att-disabled="!!state.anticipoId"/>
                    </div>

                    <div class="col-md-6">
                        <label for="cantidad" class="form-label fw-bold">Cantidad obtenida del cliente ($):</label>
                        <input type="number"
                               step="0.1"
                               id="cantidad"
                               class="form-control"
                               t-model="state.cantidadAnticipo"
                               t-att-disabled="!!state.anticipoId"/>
                    </div>

                    <div class="col-md-6">
                        <label for="dolar" class="form-label fw-bold">Precio dólar ($):</label>
                        <input type="number"
                               step="0.01"
                               id="dolar"
                               class="form-control"
                               t-model="state.precioDolar"/>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-bold">
                            PDF del anticipo
                            <span t-if="state.tipo === 'factura'" class="text-muted">(opcional)</span>
                        </label>
                        <PdfUploader
                            value="state.PDFAnticipo"
                            filename="state.PDFAnticipoNombre"
                            onChange="(b64, name) => this.onPdfChange(b64, name)"
                            previewMaxWidth="400"/>
                    </div>
                </div>
            </div>

            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="onConfirmar">
                    Guardar y salir
                </button>
                <button class="btn btn-secondary" t-on-click="onCancel">
                    Cancelar
                </button>
            </t>
        </Dialog>
    </t>
</templates>