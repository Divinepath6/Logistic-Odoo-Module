<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rastreo_paquetes.componente_detalle_cliente_embed">
        <Dialog title="state.crearEditar + ' el pago del cliente número: ' + state.numero" size="'xl'">
            
            <div class="o_form_view p-3 border rounded bg-light">
                <div class="mb-3 pb-2 border-bottom d-flex align-items-center justify-content-between" t-if="!state.anticipoId">
                    <div class="btn-group" role="group">
                        <button type="button"
                                t-attf-class="btn btn-sm {{ state.modoVinculo === 'crear' ? 'btn-primary' : 'btn-outline-primary' }}"
                                t-on-click="() => this.cambiarModoVinculo('crear')">
                            <i class="fa fa-plus-circle me-1"/> Crear nuevo pago en Odoo
                        </button>
                        <button type="button"
                                t-attf-class="btn btn-sm {{ state.modoVinculo === 'vincular' ? 'btn-primary' : 'btn-outline-primary' }}"
                                t-on-click="() => this.cambiarModoVinculo('vincular')">
                            <i class="fa fa-link me-1"/> Cargar pago ya hecho (Referencia)
                        </button>
                    </div>
                </div>

                <div class="alert alert-info py-2 px-3 mb-3" t-if="!state.anticipoId and state.modoVinculo === 'vincular'">
                    <label for="buscarRef" class="form-label fw-bold mb-1">
                        Referencia del Pago en Odoo:
                    </label>
                    <div class="input-group">
                        <input type="text"
                               id="buscarRef"
                               class="form-control"
                               placeholder="Ej. PBNK1/2026/00015 o Memo..."
                               t-model="state.referenciaBuscar"
                               t-on-keydown="(ev) => ev.key === 'Enter' and this.onBuscarReferencia()"/>
                        <button type="button"
                                class="btn btn-primary"
                                t-att-disabled="state.buscandoRef"
                                t-on-click="onBuscarReferencia">
                            <i class="fa fa-search me-1"/>
                            <t t-if="state.buscandoRef">Buscando...</t>
                            <t t-else="">Buscar y cargar</t>
                        </button>
                    </div>
                    <div class="mt-2 small text-success fw-bold" t-if="state.existingRecordId">
                        <i class="fa fa-check-circle me-1"/>
                        Vinculado a pago: <span t-esc="state.referenciaOdoo"/>
                    </div>
                </div>

                <div class="row g-4">

                    <div class="col-md-7">
                        <div class="row g-3">

                            <div class="col-md-6">
                                <label for="numeroAnticipo" class="form-label fw-bold">Número de pago:</label>
                                <span id="numeroAnticipo" class="form-control bg-white" t-esc="state.numero"/>
                            </div>

                            <div class="col-md-6">
                                <label for="fecha" class="form-label fw-bold">Última edición:</label>
                                <span id="fecha" class="form-control bg-white" t-esc="state.fechaEdicion || 'Nuevo registro'"/>
                            </div>

                            <!-- Selectores de Diario y Método de Pago (Creación) -->
                            <t t-if="!state.anticipoId and state.modoVinculo === 'crear'">
                                <div class="col-md-6">
                                    <label for="diarioPago" class="form-label fw-bold">Diario (Banco / Caja):</label>
                                    <select id="diarioPago"
                                            class="form-select"
                                            t-att-value="state.journalId"
                                            t-on-change="onDiarioChange">
                                        <option value="0">-- Seleccionar diario --</option>
                                        <t t-foreach="state.diarios" t-as="d" t-key="d.id">
                                            <option t-att-value="d.id" t-att-selected="d.id === state.journalId">
                                                <t t-esc="d.name"/>
                                            </option>
                                        </t>
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label for="metodoPago" class="form-label fw-bold">Método de pago:</label>
                                    <select id="metodoPago"
                                            class="form-select"
                                            t-att-value="state.paymentMethodLineId"
                                            t-att-disabled="!state.journalId or state.metodosDisponibles.length === 0"
                                            t-on-change="onMetodoChange">
                                        <t t-if="state.metodosDisponibles.length === 0">
                                            <option value="0">Sin métodos configurados</option>
                                        </t>
                                        <t t-foreach="state.metodosDisponibles" t-as="m" t-key="m.id">
                                            <option t-att-value="m.id" t-att-selected="m.id === state.paymentMethodLineId">
                                                <t t-esc="m.name"/>
                                            </option>
                                        </t>
                                    </select>
                                </div>
                            </t>

                            <!-- Datos en solo lectura al editar o vincular pago existente -->
                            <t t-if="state.anticipoId or state.modoVinculo === 'vincular'">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Referencia Odoo:</label>
                                    <span class="form-control bg-white">
                                        <strong t-esc="state.referenciaOdoo || 'Pago registrado'"/>
                                    </span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Diario / Método de pago:</label>
                                    <span class="form-control bg-white">
                                        <span t-esc="state.journalNombre || 'N/A'"/>
                                        <t t-if="state.paymentMethodNombre"> — <span t-esc="state.paymentMethodNombre"/></t>
                                    </span>
                                </div>
                            </t>

                            <div class="col-md-6">
                                <label for="fechaAnticipo" class="form-label fw-bold">Fecha del pago:</label>
                                <input type="date"
                                       id="fechaAnticipo"
                                       class="form-control"
                                       t-model="state.fechaAnticipo"
                                       t-att-disabled="!!state.anticipoId or state.modoVinculo === 'vincular'"/>
                            </div>

                            <div class="col-md-6">
                                <label for="cantidad" class="form-label fw-bold">Cantidad recibida (USD $):</label>
                                <input type="number"
                                       step="0.01"
                                       id="cantidad"
                                       class="form-control"
                                       t-model.number="state.cantidadAnticipo"
                                       t-att-disabled="!!state.anticipoId or state.modoVinculo === 'vincular'"/>
                            </div>

                            <div class="col-md-6">
                                <label for="dolar" class="form-label fw-bold">
                                    Precio del Dólar ($)
                                    <small t-if="state.fetchingRate" class="text-primary ms-1">(obteniendo...)</small>
                                </label>
                                <input type="number"
                                       step="0.0001"
                                       id="dolar"
                                       class="form-control"
                                       t-model.number="state.precioDolar"/>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Equivalente en MXN ($):</label>
                                <input type="text"
                                       class="form-control bg-white fw-bold text-success"
                                       t-att-value="state.montoMxnText"
                                       readonly="1"/>
                            </div>

                        </div>
                    </div>

                    <div class="col-md-5 border-start">
                        <div class="d-flex flex-column h-100">
                            <label class="form-label fw-bold text-primary">
                                Comprobante PDF del Pago
                                <span t-if="state.modoVinculo === 'vincular'" class="text-muted fw-normal"> (opcional)</span>
                            </label>
                            <div class="flex-grow-1">
                                <PdfUploader
                                    value="state.PDFAnticipo"
                                    filename="state.PDFAnticipoNombre"
                                    onChange="(b64, name) => this.onPdfChange(b64, name)"
                                    previewMaxWidth="'100%'"/>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="onConfirmar">
                    Guardar y salir
                </button>
                <button class="btn btn-secondary" t-on-click="onCancel">
                    Cancelar
                </button>
            </t>
        </Dialog>
    </t>
</templates>