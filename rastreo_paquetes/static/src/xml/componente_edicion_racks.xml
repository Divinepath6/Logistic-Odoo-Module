<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rastreo_paquetes.componente_edicion_racks_embed">
        <Dialog title="'Seleccionar / Editar Rack'" size="'md'">
             <t t-if="state.editando">
                <button class="btn btn-primary" t-on-click="onBuscarProducto">
                        <i class="oi oi-check me-1"/> Buscar Producto
                </button> 
             </t>
             <t t-else="">
                <div class="d-flex gap-2 mb-3">
                    <button class="btn btn-primary" t-on-click="onBuscar">
                        <i class="oi oi-search me-1"/> Actualizar Lista
                    </button>
                    <button class="btn btn-secondary" t-on-click="onCrearNuevo">
                        <i class="oi oi-plus me-1"/> Crear Nuevo
                    </button>
                </div>
             </t>
            

            <t t-if="state.editando">
                <div class="o_form_view p-2 border rounded bg-light">
                    <h5 class="mb-3 text-primary border-bottom pb-2">
                        <t t-if="state.rackSeleccionadoId">Editar Rack</t>
                        <t t-else="">Nuevo Rack</t>
                    </h5>

                    <div class="row g-3">
                        
                        <div class="col-md-6">
                            <label for="clave" class="form-label fw-bold">Nombre del Producto:</label>
                            <span type="text" 
                                   id="clave" 
                                   class="form-control" 
                                   t-esc="state.productoNombre"/>
                        </div>

                        <div class="col-md-6">
                            <label for="clave" class="form-label fw-bold">Precio del Producto:</label>
                            <span type="text" 
                                   id="clave" 
                                   class="form-control" 
                                   t-esc="state.productoPrecio"/>
                        </div>

                        <div class="col-md-6">
                            <label for="nombre" class="form-label fw-bold">Nombre en este sistema:</label>
                            <input type="text" 
                                   id="nombre" 
                                   class="form-control" 
                                   placeholder="Ej. Rack XXXX x XXXX x XXXX" 
                                   t-model="state.nombre"/>
                        </div>

                        <div class="col-md-6">
                            <label for="precio" class="form-label fw-bold">Precio Unitario ($)</label>
                            <input type="number" 
                                   step="0.01" 
                                   id="precio" 
                                   class="form-control" 
                                   t-model.number="state.precioUnitario"/>
                        </div>
                        <div class="col-md-6">
                            <label for="ancho" class="form-label fw-bold">Ancho (mm)</label>
                            <input type="number" 
                                   id="ancho" 
                                   class="form-control" 
                                   t-model.number="state.ancho"/>
                        </div>

                        <div class="col-md-6">
                            <label for="largo" class="form-label fw-bold">Largo (mm)</label>
                            <input type="number" 
                                   id="largo" 
                                   class="form-control" 
                                   t-model.number="state.largo"/>
                        </div>

                        <div class="col-md-6">
                            <label for="altura" class="form-label fw-bold">Altura (mm)</label>
                            <input type="number" 
                                   id="altura" 
                                   class="form-control" 
                                   t-model.number="state.altura"/>
                        </div>
                        <div class="col-md-6">
                            <label for="almacenaje" class="form-label fw-bold">Almacenaje (Tonelada)</label>
                            <input type="number" 
                                   id="almacenaje" 
                                   class="form-control" 
                                   t-model.number="state.almacenaje"/>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-2 border-top">
                        <button class="btn btn-secondary" t-on-click="onCancelarEdicion">
                            Cancelar
                        </button>
                        <button class="btn btn-primary" t-on-click="onGuardar">
                            <i class="oi oi-check me-1"/> Guardar Rack
                        </button>
                    </div>
                </div>
            </t>

            <t t-else="">
                <div class="odoo-list border rounded p-2" style="max-height: 300px; overflow-y: auto;">
                    <t t-if="state.cargando">
                        <p class="text-center text-muted my-3">Cargando...</p>
                    </t>
                    <t t-elif="state.racks.length === 0">
                        <p class="text-center text-muted my-3">No se encontraron racks.</p>
                    </t>
                    <t t-else="">
                        <div class="list-group">
                            <t t-foreach="state.racks" t-as="rack" t-key="rack.id">
                                <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center cursor-pointer"
                                     t-att-class="{ 'active': state.rackSeleccionadoId === rack.id }"
                                     t-on-click="() => {this.onSeleccionarRack(rack)}">
                                    <div>
                                        <strong><t t-esc="rack.clave"/></strong> - <t t-esc="rack.nombre || ''"/>
                                    </div>
                                    <span>
                                        $<t t-esc="rack.precio_unitario || '0.00'"/>
                                    </span>
                                </div>
                            </t>
                        </div>
                    </t>
                </div>
            </t>

            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="_onConfirm">
                    Salir
                </button>
            </t>
        </Dialog>
    </t>
</templates>