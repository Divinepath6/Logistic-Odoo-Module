<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Formato A4 con márgenes mínimos -->
    <record id="paperformat_croquis_bodega" model="report.paperformat">
        <field name="name">Croquis Bodega A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">2</field>
        <field name="margin_bottom">2</field>
        <field name="margin_left">2</field>
        <field name="margin_right">2</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>



    <record id="report_croquis_bodega" model="ir.actions.report">
        <field name="name">Croquis de Bodega</field>
        <field name="model">rastreo.bodega_cliente</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">rastreo_paquetes.report_croquis_bodega_doc</field>
        <field name="report_file">rastreo_paquetes.report_croquis_bodega_doc</field>
        <field name="print_report_name">'Croquis'</field>
        <field name="binding_model_id" eval="False"/>
        <field name="paperformat_id" ref="paperformat_croquis_bodega"/>
    </record>


    
    <template id="report_croquis_bodega_doc">
        <t t-call="web.html_container">
            <meta charset="utf-8"/>
            <t t-set="o" t-value="None"/>
            
            <style>
                .container, .article, .page, main, body {
                    margin: 0 !important;
                    padding: 0 !important;
                    max-width: 100% !important;
                    width: 100% !important;
                }
                .page {
                    page-break-after: always;
                    padding: 0 !important;
                    margin: 0 !important;
                    width: 100% !important;
                    height: 100% !important;
                }
                .content-principal {
                    width: 100% !important;
                    padding: 2mm 2mm 0 2mm !important;
                    box-sizing: border-box;
                }
                table {
                    width: 100% !important;
                    border-collapse: collapse;
                }
                tr, td, th {
                    page-break-inside: avoid;
                }
                .plano-marco {
                    border: none;
                    padding: 0;
                    background: none;
                    box-sizing: border-box;
                    width: 100%;
                    height: 275mm;
                    display: flex;
                    /* Alineación hacia arriba y a la izquierda */
                    align-items: flex-start;
                    justify-content: flex-start;
                }
                .croquis-svg-full {
                    width: 100%;
                    height: 100%; /* Forzamos a que intente usar el 100% de la altura */
                    display: block;
                    margin: 0; /* Quitamos el margen auto para pegar a la izquierda */
                }
                .texto{
                    font-size: 12px;
                    margin-bottom: 1px; 
                    color: #000000 ;"
                }
            </style>
            <div class="page">
                <div class="content-principal">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2px; border-bottom: 2px solid #ff8a3d; padding-bottom: 2px;">
                        <div>
                            <img t-if="datos.get('logo_b64')"
                                 t-att-src="'data:image/png;base64,' + datos['logo_b64']"
                                 style="max-height: 34px;"/>
                        </div>
                        <div style="text-align: left;">
                            <h1 style="margin: 0; font-size: 13px; color: #000000 ;">
                                Croquis para la propuesta
                                Fecha: <t t-esc="datos.get('fecha', '')"/>
                            </h1>
                        </div>
                    </div>

                    <div class="texto" style="margin-bottom: 1px;">
                        <b>Cliente:</b> <t t-esc="datos.get('clienteNombre', '')"/> 
                        <b>Ubicaci&#243;n:</b> <t t-esc="datos.get('ubicacion', '')"/>
                    </div>

                    <t t-if="datos.get('bodegas') and len(datos['bodegas']) > 0">
                        <t t-call="rastreo_paquetes.croquis_svg_bodega">
                            <t t-set="bodega" t-value="datos['bodegas'][0]"/>
                        </t>
                    </t>
                </div>
            </div>

            <t t-if="datos.get('bodegas') and len(datos['bodegas']) > 1">
                <t t-foreach="datos['bodegas'][1:]" t-as="b">
                    <div class="page" t-attf-style="page-break-after: #{'auto' if b_last else 'always'};">
                        <div class="content-principal">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2px; border-bottom: 1px solid #e3e7f0; padding-bottom: 2px;">
                                <div class="texto"  >
                                    <t t-esc="datos.get('clienteNombre', '')"/>
                                    <t t-esc="datos.get('ubicacion', '')"/>
                                </div>
                                <div class="texto"  >
                                    <t t-esc="datos.get('fecha', '')"/>
                                </div>
                            </div>

                            <t t-call="rastreo_paquetes.croquis_svg_bodega">
                                <t t-set="bodega" t-value="b"/>
                            </t>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="croquis_svg_bodega">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1px;">
            <h2 class="texto">
                <t t-esc="bodega['bodegaNombre']"/>
            </h2>
            <div class="texto"  >
                Ancho: <b><t t-esc="bodega['anchoBodega']"/> m</b> 
                Largo: <b><t t-esc="bodega['largoBodega']"/> m</b>
            </div>
            <div class="texto"  >
                Rack: <b><t t-esc="bodega['rackNombre']"/> </b> 
            </div>
            <div class="texto"  >
                Almacenaje Total con rack (Toneladas): <b><t t-esc="bodega['almacenaje']"/> </b> 
            </div>
            <div class="texto"  >
                Ancho del pasillo Vertical: <b><t t-esc="bodega['sobranteH']"/> m </b> 
                Ancho del pasillo Horizontal: <b><t t-esc="bodega['sobranteV']"/> m </b> 
            </div>
            <div class="texto"  >
                Separación a paredes: <b>
                <t t-esc="bodega['sepParedArr']"/>  
                <t t-esc="bodega['sepParedAba']"/> 
                <t t-esc="bodega['sepParedIzq']"/> 
                <t t-esc="bodega['sepParedDer']"/> 
                </b> 
            </div>
            
        </div>

        <div class="plano-marco">
            <t t-call="rastreo_paquetes.croquis_svg_doc"/>
        </div>
    </template>

    <template id="croquis_svg_doc">
        <t t-set="pad" t-value="2"/>
        
        <t t-set="vb_x" t-value="bodega['layout']['offsetX'] - pad"/>
        <t t-set="vb_y" t-value="bodega['layout']['offsetY'] - pad"/>
        <t t-set="vb_w" t-value="bodega['layout']['ancho'] + (pad * 2)"/>
        <t t-set="vb_h" t-value="bodega['layout']['largo'] + (pad * 2)"/>
        
        <svg xmlns="http://www.w3.org/2000/svg"
             t-att-viewBox="'%s %s %s %s' % (vb_x, vb_y, vb_w, vb_h)"
             class="croquis-svg-full"
             preserveAspectRatio="xMinYMin meet">
            
            <rect t-att-x="bodega['layout']['offsetX']" 
                  t-att-y="bodega['layout']['offsetY']"
                  t-att-width="bodega['layout']['ancho']" 
                  t-att-height="bodega['layout']['largo']"
                  fill="#FFEFE5" 
                  stroke="#4A2500" 
                  stroke-width="2"/>
             
            <g t-foreach="bodega['layout']['pasillos']" t-as="p" t-key="p['id']">
                <rect t-att-x="p['x']" t-att-y="p['y']" 
                      t-att-width="p['w']" t-att-height="p['h']"
                      fill="#cfe3ff" stroke="#7aa7e0" 
                      stroke-width="1" stroke-dasharray="6 4" 
                      opacity="0.7"/>
            </g>
            
            <g t-foreach="bodega['layout']['racks']" t-as="r" t-key="r['id']">
                <rect t-att-x="r['x']" t-att-y="r['y']" 
                      t-att-width="r['w']" t-att-height="r['h']"
                      fill="#ffffff" 
                      stroke="#ff8a3d" 
                      stroke-width="1"/> 
            </g>
        </svg>
    </template>
</odoo>
