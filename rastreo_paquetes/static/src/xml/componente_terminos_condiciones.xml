<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rastreo_paquetes.componente_terminos_condiciones_embed">
        <Dialog title="'Edición de ' + (state.documentoNombre or '')" size="'xl'">
            <div class="row">               
                <div class="col-md-6">

                    <div class="mb-3">
                        <label class="form-label fw-bold">Total del Proveedor ($):</label>
                        <input type="number"
                               step="0.01"
                               class="form-control"
                               placeholder="0.00"
                               t-model.number="state.totalProveedor"
                               t-on-input="recalcularMontos"/>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label fw-bold mb-0">Términos de Pago (1 a 4):</label>
                        <button class="btn btn-sm btn-outline-primary"
                                t-if="state.terminos.length &lt; 4"
                                t-on-click="nuevoTermino">
                            <i class="fa fa-plus me-1"/> Agregar Término
                        </button>
                    </div>

                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Término</th>
                                <th class="text-end" style="width: 100px;">%</th>
                                <th class="text-end">Cantidad</th>
                                <th class="text-center" style="width: 50px;">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="state.terminos and state.terminos.length > 0">
                                <tr t-foreach="state.terminos" t-as="t" t-key="t_index">
                                    <td>
                                        <input type="text" 
                                               class="form-control form-control-sm" 
                                               t-model="t.nombre" 
                                               placeholder="Ej: Anticipo"/>
                                    </td>
                                    <td class="text-end">
                                        <input type="number" 
                                               step="0.01" 
                                               class="form-control form-control-sm text-end" 
                                               t-model.number="t.porcentaje" 
                                               t-on-input="() => this.onPorcentajeChange(t_index)"/>
                                    </td>
                                    <td class="text-end">
                                        <span class="fw-bold text-success"><t t-esc="formatCurrency(t.cantidad)"/></span>
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm" 
                                                t-on-click="() => this.eliminarTermino(t_index)">
                                            <i class="fa fa-trash"/>
                                        </button>
                                    </td>
                                </tr>
                            </t>
                            <t t-else="">
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-3">
                                        Agregue al menos un término de pago.
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <div class="alert py-2 small d-flex justify-content-between align-items-center mt-3"
                         t-att-class="sumaPorcentajes === 100 ? 'alert-success' : 'alert-warning'"
                         t-if="state.terminos.length > 0">
                        <span>Suma total de porcentajes:</span>
                        <span class="fw-bold"><t t-esc="sumaPorcentajes"/>%</span>
                    </div>
                </div>

                <div class="col-md-6 border-start ps-md-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nombre del archivo: </label>
                        <input type="text"
                               class="form-control"
                               placeholder="Ej: contrato_proveedor.pdf"
                               t-model="state.PDFNombre"/>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Contrato en PDF:</label>
                        <PdfUploader
                            value="state.PDF"
                            filename="state.PDFNombre"
                            onChange="(b64, name) => this.onPdfChange(b64, name)"
                            previewMaxWidth="'100%'"/>
                    </div>

                    <div t-if="state.PDF" class="mt-3">
                        <button class="btn btn-outline-secondary btn-sm w-100"
                                t-on-click="onDescargarPDF">
                            <i class="fa fa-download me-1"/> Descargar PDF Actual
                        </button>
                    </div>
                </div>

            </div>

            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="onConfirmar">
                    Guardar y salir
                </button>
                <button class="btn btn-secondary" t-on-click="onCancelar">
                    Cancelar
                </button>
            </t>
        </Dialog>
    </t>
</templates>