<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="rastreo_paquetes.pantalla_pedido">
        <div class="odoo-screen">


            <div class="odoo-screen-header">
                <button type="button"
                    class="odoo-btn odoo-btn-secondary"
                    t-on-click="onClickRegresar">
                    <i class="fa fa-home" />
                </button>

                <h2> INVOICE: <t t-esc="state.numeroContrato or 'Sin número'" />
                </h2>

                <div class="ms-auto d-flex gap-2">

                    <button type="button"
                        class="odoo-btn odoo-btn-primary"
                        t-on-click="onGuardarDetalleGeneral">
                        <i class="fa fa-save" /> Guardar </button>

                    <button type="button"
                        class="odoo-btn odoo-btn-ghost"
                        t-on-click="onClickCambiarEstado">
                        <i class="fa fa-exchange" /> Siguiente Estado </button>
                </div>
            </div>

            <div class="odoo-screen-grid">

                <div class="odoo-col-left">


                    <div class="odoo-card odoo-card-accent">
                        <div class="odoo-card-title">
                            <i class="fa fa-info-circle" /> Detalle general de el pedido: 
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="odoo-field">
                                    <label class="odoo-label" for="numero_contrato">INVOICE</label>
                                    <input type="text"
                                        id="numero_contrato"
                                        class="odoo-input"
                                        t-model="state.numeroContrato"
                                        readonly="1"
                                    />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="odoo-field">
                                    <label class="odoo-label" for="numero_guia">Número de
                                        Cotización:</label>
                                    <input type="text"
                                        id="numero_guia"
                                        class="odoo-input"
                                        t-model="state.guia" 
                                        readonly="readonly"/>
                                </div>
                            </div>
                            <!-- 
                            <button type="button" class="odoo-btn odoo-btn-primary"
                                t-on-click="() => this.onCambiarCotizacion()">
                                <i class="fa fa-random"></i> Buscar Cotización </button>
                            -->

                            <div class="col-md-6">
                                <div class="odoo-field">
                                    <label class="odoo-label">Cliente</label>
                                    <input type="text"
                                        class="odoo-input"
                                        t-att-value="state.clienteNombre"
                                        readonly="readonly" />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="odoo-field">
                                    <label class="odoo-label">Proveedor</label>
                                    <div class="d-flex gap-2">
                                        <input type="text"
                                            class="odoo-input"
                                            t-att-value="state.proveedorNombre or 'Sin proveedor asignado'"
                                            readonly="readonly" />
                                        <button type="button"
                                            class="odoo-btn odoo-btn-sm odoo-btn-primary"
                                            t-on-click="() => this.onEscogerProveedor()">
                                            <i class="fa fa-search" /> Escoger
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="odoo-field">
                                    <label class="odoo-label" for="forwarder">Forwarder</label>
                                    <input type="checkbox"
                                        id="forwarder"
                                        class="odoo-input"
                                        t-att-checked="state.forwarder"
                                        t-on-change="(ev) => this.onVerificarForwarder(ev)" />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="odoo-field">
                                    <label class="odoo-label" for="salidaAduana">Salida de Aduana</label>
                                    <input type="checkbox"
                                        id="salidaAduana"
                                        class="odoo-input"
                                        t-att-checked="state.salidaAduana"
                                        t-on-change="(ev) => this.onVerificarSalidaAduana(ev)" />
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="odoo-field">
                                    <label class="odoo-label" for="contenedores">Cantidad de Contenedores</label>
                                    <input type="number"
                                        id="contenedores"
                                        class="odoo-input"
                                        step="1"
                                        t-model="state.contenedores"
                                    />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="odoo-field">
                                    <label class="odoo-label" for="total_cliente">Total Cliente</label>
                                    <input type="text"
                                        id="total_cliente"
                                        class="odoo-input"
                                        t-att-value="state.totalCliente"
                                        readonly="readonly"
                                    />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="odoo-field">
                                    <label class="odoo-label" for="clienteCostoDolar"> Costo del dolar cotizado a cliente:</label>
                                        <input type="number" 
                                        class="form-control" 
                                        step="0.01" 
                                        t-model="state.clienteCostoDolar"/>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="odoo-field">
                                    <label class="odoo-label" for="total_cliente">Total Anticipos de
                                        cliente:</label>
                                    <input type="text"
                                        id="total_cliente"
                                        class="odoo-input"
                                        t-att-value="state.totalAnticiposCliente"
                                        readonly="readonly"
                                    />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="odoo-field">
                                    <label class="odoo-label" for="total_proveedor">Total Proveedor</label>
                                    <input type="number"
                                        id="total_proveedor"
                                        class="odoo-input"
                                        t-model="state.totalProveedor"
                                        readonly="readonly"
                                    />
                                </div>
                            </div>
                            
                            <!-- 
                            <div class="col-md-6">
                                <div class="odoo-field">
                                    <label class="odoo-label" for="total_cliente"> Costo del dolar acordado con proveedor:</label>
                                        <input type="number" 
                                        class="form-control" 
                                        step="0.01" 
                                        t-model="state.total_proveedor_costo_dolar"/>
                                </div>
                            </div>
-->
                            <div class="col-md-6">
                                <div class="odoo-field">
                                    <label class="odoo-label" for="totalAnticiposProveedor">Total
                                        Anticipos al Proveedor:</label>
                                    <input type="text"
                                        id="totalAnticiposProveedor"
                                        class="odoo-input"
                                        t-att-value="state.totalAnticiposProveedor"
                                        readonly="readonly"
                                    />
                                </div>
                            </div>



                            <div class="col-md-6">
                                <div class="odoo-field">
                                    <label class="odoo-label" for="balanceCliente">Balance Cliente:</label>
                                    <input type="text"
                                        id="balanceCliente"
                                        class="odoo-input"
                                        t-att-value="state.balanceCliente"
                                        readonly="readonly"
                                    />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="odoo-field">
                                    <label class="odoo-label" for="balancePorcentajeCliente">Porcentaje
                                        Cliente:</label>
                                    <input type="text"
                                        id="balancePorcentajeCliente"
                                        class="odoo-input"
                                        t-att-value="state.balancePorcentajeCliente"
                                        readonly="readonly"
                                    />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="odoo-field">
                                    <label class="odoo-label" for="balanceProveedor">Balance
                                        Proveedor:</label>
                                    <input type="text"
                                        id="balanceProveedor"
                                        class="odoo-input"
                                        t-att-value="state.balanceProveedor"
                                        readonly="readonly"
                                    />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="odoo-field">
                                    <label class="odoo-label" for="balancePorcentajeProveedor">Porcentaje
                                        Proveedor:</label>
                                    <input type="text"
                                        id="balancePorcentajeProveedor"
                                        class="odoo-input"
                                        t-att-value="state.balancePorcentajeProveedor"
                                        readonly="readonly"
                                    />
                                </div>
                            </div>

                             <div class="col-md-6">
                                <div class="odoo-field">
                                    <label class="odoo-label" for="cotizacionAduana">Cotizacion de Aduana:
                                    </label>
                                    <input type="text"
                                        id="cotizacionAduana"
                                        class="odoo-input"
                                        t-att-value="state.cotizacionAduana"
                                        step="1"
                                    />
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="odoo-card odoo-card-accent">
                        <div class="odoo-card-title">
                            <i class="fa fa-info-circle" /> Fechas: </div>
                        <div class="cc-card">

                            <h3 class="cc-card-title">
                                <span class="cc-badge-dot">
                                    Paquete:
                                </span>
                            </h3>

                            <label class="odoo-label" for="fecha_creacion">
                                Fecha de creacion de pedido: </label>
                            <input type="date"
                                id="fecha_creacion"
                                class="form-control"
                                data-field="fecha_creacion"
                                t-att-value="state.fecha_creacion"
                                t-on-change="onVerificarFecha" />

                            <label class="odoo-label" for="fecha_termino_produccion"> Termino de
                                producción: </label>
                            <input type="date"
                                id="fecha_termino_produccion"
                                class="form-control"
                                data-field="fecha_termino_produccion"
                                t-att-value="state.fecha_termino_produccion"
                                t-on-change="onVerificarFecha" />

                            <label class="odoo-label" for="CRD"> Cargo Ready Date (CRD): </label>
                            <input type="date"
                                id="CRD"
                                class="form-control"
                                data-field="CRD"
                                t-att-value="state.CRD"
                                t-on-change="onVerificarFecha" />


                            <label class="odoo-label" for="ETD"> Estimated Time of Departure (ETD): </label>
                            <input type="date"
                                id="ETD"
                                class="form-control"
                                data-field="ETD"
                                t-att-value="state.ETD"
                                t-on-change="onVerificarFecha" />

                            <label class="odoo-label" for="ETA"> Estimated Time of Arrival (ETA): </label>
                            <input type="date"
                                id="ETA"
                                class="form-control"
                                data-field="ETA"
                                t-att-value="state.ETA"
                                readonly="readonly" />


                        </div>
                    </div>

<div class="odoo-card odoo-card-accent">
                        <div class="odoo-card-title d-flex align-items-center justify-content-between">
                            <span>
                                <i class="fa fa-info-circle" /> Fechas limite de compromiso de Pago
                                cliente
                            </span>
                            <button type="button"
                                class="odoo-btn odoo-btn-sm odoo-btn-primary ms-auto"
                                t-on-click="() => this.terminosCondicionesCliente()">
                                <i class="fa fa-percent" /> Términos
                            </button>
                        </div>

                        <div class="cc-card">
                            <t t-if="state.terminosCliente and state.terminosCliente.length > 0">
                                <t t-foreach="state.terminosCliente" t-as="t" t-key="t_index">
                                    <div class="mb-3">
                                        <label class="odoo-label">
                                            <t t-esc="t.nombre or ('Término ' + (t_index + 1))" />
                                           
                                        <strong> $<t t-esc="t.cantidad" /> </strong>
                                        (<strong><t t-esc="t.porcentaje" /></strong> %):
                                        </label>
                                        <input type="date"
                                            class="form-control"
                                            t-model="t.fecha_compromiso"
                                            t-on-change="(ev) => this.onVerificarFechaTerminoCliente(t_index, ev)" />
                                    </div>
                                </t>
                            </t>
                            <t t-else="">
                                <p class="text-muted text-center py-2">Primero agregue términos de
                                    pago para configurar sus fechas.</p>
                            </t>
                        </div>
                    </div>

                    <!-- compromisos de pagoss -->
                    <div class="odoo-card odoo-card-accent">
                        <div class="odoo-card-title">
                            <i class="fa fa-info-circle" /> Fechas límite de compromiso de pago -
                            Proveedor </div>
                        <div class="cc-card">
                            <t t-if="state.terminos and state.terminos.length > 0">
                                <t t-foreach="state.terminos" t-as="t" t-key="t_index">
                                    <div class="mb-3">
                                        <label class="odoo-label">
                                            <t t-esc="t.nombre or ('Término ' + (t_index + 1))" /> 
                                            <strong>
                                                $<t
                                                t-esc="t.cantidad" /></strong>
                                                (<strong><t
                                                t-esc="t.porcentaje" /></strong> %): </label>
                                        <input type="date"
                                            class="form-control"
                                            t-model="t.fecha_compromiso"
                                            t-on-change="(ev) => this.onVerificarFechaTermino(t_index, ev)" />
                                    </div>
                                </t>
                            </t>
                            <t t-else="">
                                <p class="text-muted text-center py-2">Primero agregue términos de
                                    pago para configurar sus fechas.</p>
                            </t>
                        </div>
                    </div>

                    <div class="odoo-card">
                        <div class="odoo-card-title">
                            <i class="fa fa-user" /> Cliente (Pagos registrados) </div>

                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th>Referencia</th>
                                        <th>Fecha</th>
                                        <th class="text-end">Monto (USD)</th>
                                        <th class="text-end">Precio Dólar</th>
                                        <th>Estado</th>
                                        <th class="text-center">PDF anticipo</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="state.detalleCliente and state.detalleCliente.length">
                                        <tr t-foreach="state.detalleCliente" t-as="d"
                                            t-key="d.anticipoId or d.paymentId or d_index">
                                            <td>
                                                 <strong><t t-esc="d.referencia or ''" /></strong>
                                            </td>
                                            <td>
                                                <t t-esc="d.fechaAnticipo or ''" />
                                            </td>
                                            <td class="text-end">
                                                <t t-esc="d.monto" />
                                            </td>
                                            <td class="text-end">
                                                $<t t-esc="d.precioDolar_fmt" />
                                            </td>
                                            <td>
                                                <span t-if="d.pagado" class="text-success">
                                                    <i class="fa fa-check" /> Pagado </span>
                                                <span t-else="" class="text-warning">
                                                    <t t-esc="d.estado or ''" />
                                                </span>
                                            </td>

                                            <td class="text-end">
                                                <t t-esc="d.PDFAnticipo or 'No cargado'" />
                                            </td>

                                            <td class="text-end">
                                                <button class="odoo-btn odoo-btn-sm odoo-btn-cyan"
                                                    t-on-click="() => this.onEditarDetalleCliente(d)">
                                                    Editar
                                                </button>
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-else="">
                                        <tr>
                                            <td colspan="9" class="text-center text-muted">
                                                Sin pagos registrados
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>

                        <div class="text-center">
                            <button class="odoo-btn odoo-btn-block odoo-btn-ghost"
                                t-on-click="() => this.onEditarDetalleCliente()">
                                <i class="fa fa-plus" /> Nuevo Anticipo </button>
                            <button class="odoo-btn odoo-btn-block odoo-btn-ghost"
                                t-on-click="() => this.onEditarDetalleCliente('cargar')">
                                <i class="fa fa-cloud-upload" /> Cargar anticipo </button>
                        </div>
                    </div>

                </div>

                <div class="odoo-col-right">

                    <div class="odoo-card">
                        <div class="odoo-card-title">
                            <i class="fa fa-flag" /> Estado del pedido
                        </div>

                        <t t-set="estados_pedido" t-value="[
                            ['fase_inicial', 'Fase inicial'],
                            ['produccion', 'En Producción'],
                            ['puerto_origen', 'Puerto de origen'],
                            ['agua', 'En el Agua'],
                            ['puerto_destino', 'Puerto de Destino'],
                            ['entregado', 'Entregado']
                        ]" />
                        <t t-set="indice_actual" t-value="estados_pedido.findIndex(e => e[0] === state.estado)" />

                        <div class="odoo-statusbar">
                            <t t-foreach="estados_pedido" t-as="item" t-key="item[0]">
                                <t t-set="is_active" t-value="item[0] === state.estado" />
                                <t t-set="is_done" t-value="indice_actual !== -1 and item_index &lt; indice_actual" />
                                
                                <div t-attf-class="odoo-statusbar-step {{ is_active ? 'is-active' : '' }} {{ is_done ? 'is-done' : '' }}"
                                    t-att-title="item[1]">
                                    <i t-if="is_done" class="fa fa-check odoo-step-icon" />
                                    <span class="odoo-step-text"><t t-esc="item[1]" /></span>
                                </div>
                            </t>
                        </div>
                    </div>
                    <div class="odoo-card">
                        <div class="odoo-card-title">
                            <i class="fa fa-folder-open" /> Documentos del sistema </div>

                        <div class="odoo-result-row">

                            <span class="odoo-result-label">Contrato Proveedor</span>
                            <span>
                                <t t-if="state.pdfContratoProveedor">
                                    <span>
                                        <strong>En el sistema</strong>
                                    </span>
                                    <i class="oi" data-icon="check" />
                                </t>
                                <t t-else="">
                                    <span class="text-muted">No cargado </span>
                                </t>
                                <button type="button"
                                    class="odoo-btn odoo-btn-sm odoo-btn-primary ms-auto"
                                    t-on-click=" () => this.terminosCondiciones('pdf_contrato_proveedor')">
                                    <i class="fa fa-percent" /> Términos </button>
                            </span>
                        </div>


                        <div class="odoo-result-row">
                            <span class="odoo-result-label">Prefactura de Proveedor</span>
                            <span>
                                <t t-if="state.pdfPrefactura">
                                    <span>
                                        <strong>En el sistema</strong>
                                    </span>
                                    <i class="oi" data-icon="check" />
                                </t>
                                <t t-else="">
                                    <span class="text-muted">No cargado </span>
                                </t>
                                <button type="button"
                                    class="odoo-btn odoo-btn-primary"
                                    t-on-click=" () => this.verPDF('pdf_prefactura')">
                                    <i class="fa fa-save" /> Ver </button>

                            </span>
                        </div>


                        <div class="odoo-result-row">
                            <span class="odoo-result-label"> invoice </span>
                            <span>
                                <t t-if="state.pdfInvoice">
                                    <span>
                                        <strong>En el sistema</strong>
                                    </span>
                                    <i class="oi" data-icon="check" />
                                </t>
                                <t t-else="">
                                    <span class="text-muted">No cargado </span>
                                </t>
                                <button type="button"
                                    class="odoo-btn odoo-btn-primary"
                                    t-on-click=" () => this.verPDF('pdf_invoice')">
                                    <i class="fa fa-save" /> Ver </button>
                            </span>
                        </div>


                        <div class="odoo-result-row">
                            <span class="odoo-result-label">Factura Proveedor </span>
                            <span>
                                <t t-if="state.pdfFacturaProveedor">
                                    <span>
                                        <strong>En el sistema</strong>
                                    </span>
                                    <i class="oi" data-icon="check" />
                                </t>
                                <t t-else="">
                                    <span class="text-muted">No cargado </span>
                                </t>
                                <button type="button"
                                    class="odoo-btn odoo-btn-primary"
                                    t-on-click=" () => this.verPDF('pdf_factura_proveedor')">
                                    <i class="fa fa-save" /> Ver </button>

                            </span>
                        </div>

                        <div class="odoo-result-row">
                            <span class="odoo-result-label"> BL </span>
                            <span>
                                <t t-if="state.pdfBL">
                                    <span>
                                        <strong>En el sistema</strong>
                                    </span>
                                    <i class="oi" data-icon="check" />
                                </t>
                                <t t-else="">
                                    <span class="text-muted">No cargado </span>
                                </t>
                                <button type="button"
                                    class="odoo-btn odoo-btn-primary"
                                    t-on-click="  () => this.verPDF('pdf_BL')">
                                    <i class="fa fa-save" /> Ver </button>
                            </span>
                        </div>
                        <!-- PL-->
                        <div class="odoo-result-row">
                            <span class="odoo-result-label"> PL </span>
                            <span>
                                <t t-if="state.pdfPL">
                                    <span>
                                        <strong>En el sistema</strong>
                                    </span>
                                    <i class="oi" data-icon="check" />
                                </t>
                                <t t-else="">
                                    <span class="text-muted">No cargado </span>
                                </t>
                                <button type="button"
                                    class="odoo-btn odoo-btn-primary"
                                    t-on-click="  () =>this.verPDF('pdf_PL')">
                                    <i class="fa fa-save" /> Ver </button>
                            </span>
                        </div>

                        <div class="odoo-result-row">
                            <span class="odoo-result-label"> Aviso de Arribo </span>
                            <span>
                                <t t-if="state.pdfAviso">
                                    <span>
                                        <strong>En el sistema</strong>
                                    </span>
                                    <i class="oi" data-icon="check" />
                                </t>
                                <t t-else="">
                                    <span class="text-muted">No cargado </span>
                                </t>
                                <button type="button"
                                    class="odoo-btn odoo-btn-primary"
                                    t-on-click="  () =>this.verPDF('pdf_aviso')">
                                    <i class="fa fa-save" /> Ver </button>
                            </span>
                        </div>
                        
                        <div class="odoo-result-row">
                            <span class="odoo-result-label"> Flete: </span>
                            <span>
                                <t t-if="state.pdfFlete">
                                    <span>
                                        <strong>En el sistema</strong>
                                    </span>
                                    <i class="oi" data-icon="check" />
                                </t>
                                <t t-else="">
                                    <span class="text-muted">No cargado </span>
                                </t>
                                <button type="button"
                                    class="odoo-btn odoo-btn-primary"
                                    t-on-click="  () =>this.verPDF('pdf_flete')">
                                    <i class="fa fa-save" /> Ver </button>
                            </span>
                        </div>

                        <div class="odoo-result-row">
                            <span class="odoo-result-label"> Evidencia de entregado a cliente: </span>
                            <span>
                                <t t-if="state.pdfEvidenciaEntregado">
                                    <span>
                                        <strong>En el sistema</strong>
                                    </span>
                                    <i class="oi" data-icon="check" />
                                </t>
                                <t t-else="">
                                    <span class="text-muted">No cargado </span>
                                </t>
                                <button type="button"
                                    class="odoo-btn odoo-btn-primary"
                                    t-on-click="  () => this.verPDF('pdf_evidencia_entregado')">
                                    <i class="fa fa-save" /> Ver </button>
                            </span>
                        </div>
                        
                    </div>

                    <!-- PROVEEDOR  -->
                    <div class="odoo-card">
                        <div class="odoo-card-title">
                            <i class="fa fa-truck" /> Proveedor </div>

                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th>Referencia</th>
                                        <th>Fecha de Anticipo</th>
                                        <th class="text-end">Cantidad transferida</th>
                                        <th class="text-end">Precio dólar</th>
                                        <th class="text-center">PDF anticipo</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t
                                        t-if="state.detalleProveedor and state.detalleProveedor.length">
                                        <tr t-foreach="state.detalleProveedor" t-as="d" t-key="d.id">
                                            <td>
                                               <strong> <t t-esc="d.referencia"/></strong>
                                            </td>
                                            <td>
                                                <t t-esc="d.fechaAnticipo or ''" />
                                            </td>
                                            <td class="text-end">
                                                <t t-esc="d.cantidadAnticipo_fmt or 0" />
                                            </td>
                                            <td class="text-end">
                                                <t t-esc="d.precioDolar_fmt or 0" />
                                            </td> 
                                            <td class="text-end">
                                                <t t-esc="d.PDFAnticipo or 'No cargado'" />
                                            </td>
                                            <td class="text-center">
                                                <button class="odoo-btn odoo-btn-sm odoo-btn-cyan"
                                                    t-on-click="() => this.onEditarDetalleProveedor(d)">
                                                    Editar
                                                </button>
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-else="">
                                        <tr>
                                            <td colspan="5" class="text-center text-muted">
                                                Sin registros
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>

                        <div class="text-center">
                            <button class="odoo-btn odoo-btn-block odoo-btn-ghost"
                                t-on-click="() => this.onEditarDetalleProveedor()">
                                <i class="fa fa-plus" /> Nuevo Anticipo </button>
                            <button class="odoo-btn odoo-btn-block odoo-btn-ghost"
                                t-on-click="() => this.onEditarDetalleProveedor('cargar')">
                                <i class="fa fa-cloud-upload" /> Cargar Anticipo </button>
                        </div>
                    </div>

                    <div class="odoo-card">

                        <div class="odoo-card-title">
                            <i class="fa fa-cubes" /> Detalle de Racks </div>

                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th>Descripción</th>
                                        <th class="text-end">Costo</th>
                                        <th class="text-end">Cant.</th>
                                        <th class="text-end">SubTotal</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="state.detalleRacks and state.detalleRacks.length">
                                        <tr t-foreach="state.detalleRacks" t-as="r" t-key="r.id">
                                            <td>
                                                <div
                                                    style="display: flex; align-items: center; gap: 0.75rem;">
                                                    <div title="Haz clic para cambiar el color"
                                                        style="position: relative; cursor: pointer; display: inline-flex; align-items: center;"
                                                        t-on-click="() => this.onEditarColorRack(r)">

                                                        <span
                                                            t-att-style="'background-color: ' + (r.colorHex || '#cccccc') + '; width: 1.5rem; height: 1.5rem; border-radius: 50%; border: 1px solid #ccc; display: inline-block;'" />

                                                        <i class="fa fa-pencil"
                                                            style="position: absolute; font-size: 0.65rem; background: rgba(0,0,0,0.6); color: #fff; border-radius: 50%; padding: 2px; bottom: -2px; right: -2px;" />
                                                    </div>

                                                    <div>
                                                        <strong>
                                                            <t t-esc="r.rack_nombre or ''" />
                                                        </strong>
                                                        <div class="odoo-text-muted"
                                                            style="font-size: 0.75rem;"> Clave: <t
                                                                t-esc="r.colorClave || 'N/A'" />
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-end">
                                                <t t-esc="r.costo_rack or 0" />
                                            </td>
                                            <td class="text-end">
                                                <t t-esc="r.cantidad_racks or 0" />
                                            </td>
                                            <td class="text-end">
                                                <t t-esc="r.subtotal or 0" />
                                            </td>

                                        </tr>
                                    </t>
                                    <t t-else="">
                                        <tr>
                                            <td colspan="6" class="text-center text-muted">
                                                Sin racks registrados
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- HISTORIAL DE ETAs -->
                    <div class="odoo-card">
                        <div class="odoo-card-title">
                            <i class="fa fa-calendar" /> Historial de ETAs
                        </div>

                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th>N° ETA</th>
                                        <th>Fecha</th>
                                        <th>Observación</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="state.listaEtas and state.listaEtas.length">
                                        <tr t-foreach="state.listaEtas" t-as="eta" t-key="eta.id or eta.numero or eta_index">
                                            <td>
                                                <strong>#<t t-esc="eta.numero" /></strong>
                                            </td>
                                            <td>
                                                <t t-esc="eta.fecha or ''" />
                                            </td>
                                            <td>
                                                <t t-esc="eta.texto or ''" />
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-else="">
                                        <tr>
                                            <td colspan="4" class="text-center text-muted">
                                                Sin ETAs registradas
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>

                        <div class="text-center">
                            <button type="button"
                                class="odoo-btn odoo-btn-block odoo-btn-ghost"
                                t-on-click="() => this.onEditarDetalleEta()">
                                <i class="fa fa-plus" /> Agregar Nueva ETA
                            </button>
                        </div>
                    </div>
                </div>
                
            </div>

            <!-- ============================================
                 TABLA DE ACTUALIZACIONES
                 ============================================ -->
            <div class="odoo-card mt-3">
                <div class="odoo-card-title">
                    <i class="fa fa-history" /> Tabla de actualizaciones </div>

                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr>
                                <th>N° Actualización</th>
                                <th>Fecha</th>
                                <th>Detalle</th>
                                <th>Usuario</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="state.actualizaciones and state.actualizaciones.length">
                                <tr t-foreach="state.actualizaciones" t-as="act" t-key="act.id">
                                    <td>
                                        <t t-esc="act.numero_actualizacion" />
                                    </td>
                                    <td>
                                        <t t-esc="act.fecha" />
                                    </td>
                                    <td>
                                        <t t-esc="act.texto" />
                                    </td>
                                    <td>
                                        <t t-esc="act.usuario" />
                                    </td>
                                </tr>
                            </t>
                            <t t-else="">
                                <tr>
                                    <td colspan="3" class="text-center text-muted">
                                        No hay actualizaciones registradas.
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </t>
</templates>